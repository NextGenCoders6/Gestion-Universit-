# Configuration de la pile Docker — copier en erp/.env (ignoré par git) et renseigner les secrets.
# Compose le lit automatiquement (variables de docker-compose.yml et environnement du conteneur web).

# Django
SECRET_KEY=remplacez-par-une-longue-valeur-aleatoire
DEBUG=False
# Noms et adresses par lesquels on joint l'ERP (sans le port).
ALLOWED_HOSTS=localhost,127.0.0.1
# Origines complètes (avec le port) acceptées pour les formulaires de l'administration Django.
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Adresse publique de l'ERP : les QR codes des documents officiels pointent vers BASE_URL/verifier/<jeton>.
BASE_URL=http://localhost:8080
# Mettre True derrière un HTTPS (le frontal transmet X-Forwarded-Proto) : cookies sécurisés.
DERRIERE_HTTPS=False

# Base MySQL (créée au premier démarrage)
DB_NAME=uccb_erp
DB_USER=uccb
DB_PASSWORD=remplacez-moi
MYSQL_ROOT_PASSWORD=remplacez-moi-aussi

# Port publié sur la machine hôte
HTTP_PORT=8080

# Envoi des e-mails (lien « mot de passe oublié »). Sans EMAIL_HOST, les e-mails
# sont écrits dans les journaux du serveur au lieu d'être envoyés.
# EMAIL_HOST=smtp.example.org
# EMAIL_PORT=587
# EMAIL_HOST_USER=ne-pas-repondre@example.org
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=UCCB ERP <ne-pas-repondre@example.org>
