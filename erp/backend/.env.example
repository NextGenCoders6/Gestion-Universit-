SECRET_KEY=change-moi
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# mysql (défaut) ou sqlite
DB_ENGINE=mysql
DB_NAME=uccb_erp
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Adresse publique de l’ERP (QR codes des documents officiels → BASE_URL/verifier/<jeton>)
BASE_URL=http://localhost:8000

# Envoi des e-mails (lien « mot de passe oublié »). Sans EMAIL_HOST, les e-mails
# sont écrits dans les journaux du serveur au lieu d'être envoyés.
# EMAIL_HOST=smtp.example.org
# EMAIL_PORT=587
# EMAIL_HOST_USER=ne-pas-repondre@example.org
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL=UCCB ERP <ne-pas-repondre@example.org>
